PORT=8000
MONGODB_URI=mongodb://localhost:27017

# Optional: overrides the database name (defaults to asha_sathi).
MONGODB_DB_NAME=asha_sathi

# Generate a strong random value, e.g. `openssl rand -hex 32`. Required — the
# server refuses to start without it.
JWT_SECRET=

# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional: enables real SMS for the panic button. Without these, panic alerts
# are logged to the console instead of sent (see sendSms in routes/asha.ts).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional. Leave empty for the normal single-service deployment, where this
# process serves the frontend too and same-origin requests need no CORS.
# Only set it (comma-separated) if you host the frontend separately.
ALLOWED_ORIGIN=
