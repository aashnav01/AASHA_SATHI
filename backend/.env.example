PORT=8000
MONGODB_URI=mongodb://localhost:27017

# Optional: overrides the database name (defaults to asha_sathi).
MONGODB_DB_NAME=asha_sathi

# Generate a strong random value, e.g. `openssl rand -hex 32`. Required — the
# server refuses to start without it.
JWT_SECRET=

# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional: enables real SMS for the panic button. Without these, panic alerts
# are logged to the console instead of sent (see sendSms in routes/asha.ts).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional. Leave empty for the normal single-service deployment, where this
# process serves the frontend too and same-origin requests need no CORS.
# Only set it (comma-separated) if you host the frontend separately.
ALLOWED_ORIGIN=

# ── Optional one-shot seeding ────────────────────────────────────────────────
# For hosts with no shell access (a free Render instance cannot run
# `npm run seed`). Set SEED_ON_START=true together with SEED_MOBILE and
# SEED_PIN, deploy once, then unset SEED_ON_START.
#
# It only runs when the database has no users, so it cannot overwrite real
# data. There is no default credential - choose your own, and treat the PIN
# as a password.
SEED_ON_START=
SEED_NAME=
SEED_MOBILE=
SEED_PIN=
