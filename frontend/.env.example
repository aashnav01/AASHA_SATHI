# Optional. The app calls /api relatively, which works in production (the API
# serves the frontend from the same origin) and in dev (vite.config.ts proxies
# /api to the API process). Set this only if you host the frontend separately
# from the API, e.g. https://your-api.onrender.com/api
VITE_API_URL=

# Optional: point the dev proxy at a non-default API address.
# VITE_DEV_API_TARGET=http://localhost:8000
